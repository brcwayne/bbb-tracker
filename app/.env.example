# Google OAuth client id (Web application) for the Drive data source.
# Leave blank to use the local data source only.
VITE_GOOGLE_CLIENT_ID=
# API key (restricted to the Picker API) and the Google Cloud project number.
# Both are required by the Picker for the drive.file scope.
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
